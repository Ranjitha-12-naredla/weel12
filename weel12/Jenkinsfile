
pipeline {
    agent any

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('weel12') {
                    bat '"C:\\Users\\ranji\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m pip install -r requirements.txt'
                }
            }
        }

        stage('Run Flask Application') {
            steps {
                dir('weel12') {
                    bat 'start /B "FlaskApp" "C:\\Users\\ranji\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" app.py'
                    bat 'timeout /t 5 /nobreak >NUL'
                }
            }
        }

        stage('Run Selenium Tests') {
            steps {
                dir('weel12') {
                    bat '"C:\\Users\\ranji\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m pytest -v tests --junitxml=test-results.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('weel12') {
                    bat 'docker build -t week12-flask:latest .'
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'weel12/test-results.xml',
                  allowEmptyResults: true
        }

        success {
            echo 'CI pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check Console Output.'
        }
    }
}

