
pipeline {
    agent any

    environment {
        PYTHON = 'C:\\Users\\ranji\\AppData\\Local\\Programs\\Python\\Python313\\python.exe'
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('weel12') {
                    bat '"%PYTHON%" -m pip install -r requirements.txt'
                }
            }
        }

        stage('Run Flask Application') {
            steps {
                dir('weel12') {
                    bat '''
                        start "FlaskApp" /B "%PYTHON%" app.py
                        ping 127.0.0.1 -n 6 > nul
                    '''
                }
            }
        }

        stage('Run Selenium Tests') {
            steps {
                dir('weel12') {
                    bat '"%PYTHON%" -m pytest -v tests --junitxml=test-results.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('weel12') {
                    bat 'docker build -t week12-flask:latest .'
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'weel12/test-results.xml',
                  allowEmptyResults: true
        }

        success {
            echo 'Week 12 CI pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check Console Output for the error.'
        }
    }
}

